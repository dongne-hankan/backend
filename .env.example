DB_PASSWORD=dongne
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao
