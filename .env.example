# 이 파일을 .env로 복사해 값을 채운다. 백엔드가 시작할 때 자동으로 읽는다. JWT_SECRET은 필수이고 32바이트 이상이어야 한다. (생성: openssl rand -base64 48)
# Neon을 쓰면 pooled가 아닌 direct 접속 주소를 넣는다. 예: jdbc:postgresql://ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/dongne_hankan
DB_USERNAME=dongne
DB_PASSWORD=dongne
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao

# Gemini는 백엔드에서만 호출한다. 비워 두면 기본 추천으로 동작한다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MAX_CONCURRENT_REQUESTS=2
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_CONNECT_TIMEOUT_MS=1000
GEMINI_READ_TIMEOUT_MS=3000
AI_REASON_TIMEOUT_MS=1500
# 주변 장소 검색용 카카오 REST API 키 (미설정 시 KAKAO_CLIENT_ID 사용)
KAKAO_REST_API_KEY=
